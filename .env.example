# Root Environment Configuration Template

# ==========================================
# Frontend Configuration (Safe for Browser)
# ==========================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# ==========================================
# Backend Configuration (Private Server Keys)
# ==========================================
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/oceanberg-digital-twin
MONGODB_DB=oceanberg-digital-twin
ML_SERVICE_URL=http://localhost:8000
ALLOWED_ORIGINS=*

# Firebase Auth Credentials (Server)
FIREBASE_USER_EMAIL=user@example.com
FIREBASE_USER_PASSWORD=somepassword
FIREBASE_UID=someuid
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-credentials.json
# Or raw JSON string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# SMTP Email Config (Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=username@example.com
SMTP_PASS=password
SMTP_FROM="Digital Twin Substation <username@example.com>"

# ==========================================
# ML Service Configuration
# ==========================================
ML_PORT=8000
ML_PREDICT_TIMEOUT_MS=15000
